{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "health.input.json",
	"x-contract-version": "0.1.0",
	"$defs": {
		"Ticket": {
			"type": "object",
			"properties": {
				"gate": {
					"type": "string"
				},
				"model": {
					"type": "string"
				},
				"era": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				},
				"generation": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				},
				"probe": {
					"type": "boolean"
				},
				"serial": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				}
			},
			"required": [
				"gate",
				"model",
				"era",
				"generation",
				"probe",
				"serial"
			]
		},
		"Admission": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "go"
						},
						"ticket": {
							"$ref": "#/$defs/Ticket"
						}
					},
					"required": [
						"kind",
						"ticket"
					]
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "gaveUp"
						}
					},
					"required": [
						"kind"
					]
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "stopped"
						}
					},
					"required": [
						"kind"
					]
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "retired"
						}
					},
					"required": [
						"kind"
					]
				}
			],
			"x-tag": "kind"
		},
		"GateWaiting": {
			"type": "object",
			"properties": {
				"model": {
					"type": "string"
				},
				"resumeAt": {
					"type": [
						"number",
						"null"
					]
				},
				"pause": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				},
				"of": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				}
			},
			"required": [
				"model",
				"resumeAt",
				"pause",
				"of"
			]
		},
		"GateSettled": {
			"type": "string",
			"enum": [
				"done",
				"again",
				"gaveUp"
			]
		},
		"GateOutcome": {
			"type": "string",
			"enum": [
				"ok",
				"overloaded",
				"failed",
				"cancelled"
			]
		},
		"PoolState": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "clear"
						}
					},
					"required": [
						"kind"
					]
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "paused"
						},
						"reason": {
							"type": "string",
							"enum": [
								"allowance",
								"credit"
							]
						},
						"until": {
							"type": "number"
						}
					},
					"required": [
						"kind",
						"reason",
						"until"
					]
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "reset"
						},
						"at": {
							"type": "number"
						}
					},
					"required": [
						"kind",
						"at"
					]
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "balance"
						},
						"eta": {
							"type": "number"
						},
						"next": {
							"type": "number"
						},
						"probe": {
							"anyOf": [
								{
									"type": "object",
									"properties": {
										"ticket": {
											"$ref": "#/$defs/Ticket"
										},
										"at": {
											"type": "number"
										}
									},
									"required": [
										"ticket",
										"at"
									]
								},
								{
									"type": "null"
								}
							]
						}
					},
					"required": [
						"kind",
						"eta",
						"next",
						"probe"
					]
				}
			],
			"x-tag": "kind"
		},
		"PoolEvent": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "billed"
						},
						"source": {
							"type": "string"
						},
						"plan": {
							"type": "string"
						},
						"extraUsage": {
							"type": "boolean"
						}
					},
					"required": [
						"kind",
						"source",
						"extraUsage"
					]
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "refused"
						},
						"reason": {
							"type": "string",
							"enum": [
								"allowance",
								"credit"
							]
						},
						"resetsAt": {
							"type": "number"
						},
						"retryAfterMs": {
							"type": "number"
						}
					},
					"required": [
						"kind",
						"reason"
					]
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "extraUsage"
						},
						"on": {
							"type": "boolean"
						},
						"lastBill": {
							"type": "string"
						}
					},
					"required": [
						"kind",
						"on"
					]
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "admitted"
						},
						"ticket": {
							"$ref": "#/$defs/Ticket"
						}
					},
					"required": [
						"kind",
						"ticket"
					]
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "settled"
						},
						"ticket": {
							"$ref": "#/$defs/Ticket"
						}
					},
					"required": [
						"kind",
						"ticket"
					]
				}
			],
			"x-tag": "kind"
		},
		"PoolVerdict": {
			"type": "object",
			"properties": {
				"skip": {
					"$ref": "provider.input.json#/$defs/SkipReason"
				},
				"blocked": {
					"$ref": "#/$defs/Blocked"
				}
			},
			"required": [
				"skip"
			]
		},
		"Blocked": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "keyRejected"
						}
					},
					"required": [
						"kind"
					]
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "spendLimit"
						},
						"resetsAt": {
							"type": "number"
						},
						"nextTryAt": {
							"type": "number"
						}
					},
					"required": [
						"kind"
					]
				}
			],
			"x-tag": "kind"
		},
		"HealthChange": {
			"type": "object",
			"properties": {
				"entry": {
					"type": "string"
				},
				"changed": {
					"minItems": 1,
					"type": "array",
					"items": {
						"type": "string",
						"enum": [
							"key",
							"billed",
							"pool",
							"waiting"
						]
					}
				}
			},
			"required": [
				"entry",
				"changed"
			]
		},
		"EntryHealth": {
			"type": "object",
			"properties": {
				"entry": {
					"type": "string"
				},
				"key": {
					"$ref": "provider.input.json#/$defs/KeyState"
				},
				"billed": {
					"$ref": "provider.input.json#/$defs/Billed"
				},
				"pool": {
					"$ref": "#/$defs/PoolState"
				},
				"waiting": {
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			},
			"required": [
				"entry",
				"key",
				"pool",
				"waiting"
			]
		},
		"Notice": {
			"type": "object",
			"properties": {
				"kind": {
					"$ref": "provider.input.json#/$defs/NoticeKind"
				},
				"status": {
					"$ref": "#/$defs/ErrorStatus"
				},
				"message": {
					"type": "string"
				},
				"reasons": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"limit": {
					"type": "number"
				},
				"reset": {
					"type": "string"
				},
				"resetsAt": {
					"type": "number"
				},
				"nextTryAt": {
					"type": "number"
				},
				"model": {
					"type": "string"
				},
				"entry": {
					"type": "string"
				}
			},
			"required": [
				"kind"
			]
		},
		"ErrorStatus": {
			"type": [
				"number",
				"string"
			]
		},
		"RetryOptions": {
			"type": "object",
			"properties": {
				"tries": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				},
				"budgetMs": {
					"type": "number",
					"minimum": 0
				},
				"capMs": {
					"type": "number",
					"minimum": 0
				},
				"baseMs": {
					"type": "number",
					"minimum": 0
				}
			}
		}
	}
}
