{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "torture.output.json",
	"x-contract-version": "0.1.0",
	"$defs": {
		"Color": {
			"type": "string",
			"enum": [
				"red",
				"green",
				"light-blue"
			]
		},
		"Name": {
			"type": "string",
			"minLength": 1,
			"maxLength": 3
		},
		"Names": {
			"maxItems": 2,
			"type": "array",
			"items": {
				"$ref": "#/$defs/Name"
			}
		},
		"Several": {
			"minItems": 2,
			"maxItems": 3,
			"type": "array",
			"items": {
				"type": "integer",
				"minimum": -9007199254740991,
				"maximum": 9007199254740991
			}
		},
		"Leaf": {
			"type": "object",
			"properties": {
				"kind": {
					"type": "string",
					"const": "leaf"
				},
				"value": {
					"type": "integer",
					"minimum": -9007199254740991,
					"maximum": 9007199254740991
				},
				"color": {
					"$ref": "#/$defs/Color"
				}
			},
			"required": [
				"kind",
				"value"
			],
			"additionalProperties": false
		},
		"Branch": {
			"type": "object",
			"properties": {
				"kind": {
					"type": "string",
					"const": "branch"
				},
				"kids": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/Tree"
					}
				}
			},
			"required": [
				"kind",
				"kids"
			],
			"additionalProperties": false
		},
		"Tree": {
			"oneOf": [
				{
					"$ref": "#/$defs/Leaf"
				},
				{
					"$ref": "#/$defs/Branch"
				}
			],
			"x-tag": "kind"
		},
		"Chain": {
			"type": "object",
			"properties": {
				"value": {
					"type": "number"
				},
				"next": {
					"anyOf": [
						{
							"$ref": "#/$defs/Chain"
						},
						{
							"type": "null"
						}
					]
				}
			},
			"required": [
				"value",
				"next"
			],
			"additionalProperties": false
		},
		"Presence": {
			"type": "object",
			"properties": {
				"optional": {
					"type": "string"
				},
				"nullable": {
					"type": [
						"string",
						"null"
					]
				},
				"both": {
					"type": [
						"string",
						"null"
					]
				},
				"defaulted": {
					"default": 3,
					"type": "integer",
					"minimum": -9007199254740991,
					"maximum": 9007199254740991
				},
				"defaultedNull": {
					"default": null,
					"type": [
						"string",
						"null"
					]
				},
				"list": {
					"default": [
						"a"
					],
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"any": {},
				"must": {}
			},
			"required": [
				"nullable",
				"defaulted",
				"defaultedNull",
				"list",
				"must"
			],
			"additionalProperties": false
		},
		"Overlap": {
			"anyOf": [
				{
					"type": "object",
					"properties": {
						"a": {
							"type": "string"
						}
					},
					"required": [
						"a"
					],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"a": {
							"type": "string"
						},
						"b": {
							"type": "number"
						}
					},
					"required": [
						"a",
						"b"
					],
					"additionalProperties": false
				},
				{
					"$ref": "#/$defs/Leaf"
				},
				{
					"type": "string",
					"const": "auto"
				},
				{
					"type": "string"
				},
				{
					"type": "integer",
					"minimum": -9007199254740991,
					"maximum": 9007199254740991
				},
				{
					"type": "number"
				},
				{
					"type": "null"
				},
				{
					"type": "array",
					"items": {
						"type": "boolean"
					}
				}
			]
		},
		"Open": {
			"type": "object",
			"properties": {
				"counts": {
					"type": "object",
					"propertyNames": {
						"type": "string"
					},
					"additionalProperties": {
						"type": "integer",
						"minimum": 0,
						"maximum": 9007199254740991
					}
				},
				"nested": {
					"type": "object",
					"propertyNames": {
						"type": "string"
					},
					"additionalProperties": {
						"type": "object",
						"propertyNames": {
							"type": "string"
						},
						"additionalProperties": {
							"$ref": "#/$defs/Leaf"
						}
					}
				}
			},
			"required": [
				"counts",
				"nested"
			],
			"additionalProperties": false
		},
		"Bounded": {
			"type": "object",
			"properties": {
				"name": {
					"$ref": "#/$defs/Name"
				},
				"ratio": {
					"type": "number",
					"exclusiveMinimum": 0,
					"maximum": 1
				},
				"few": {
					"minItems": 1,
					"maxItems": 2,
					"type": "array",
					"items": {
						"type": "boolean"
					}
				},
				"level": {
					"type": "integer",
					"minimum": -2,
					"maximum": 2
				},
				"count": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				}
			},
			"required": [
				"name",
				"ratio",
				"few",
				"level",
				"count"
			],
			"additionalProperties": false
		},
		"Literals": {
			"type": "object",
			"properties": {
				"yes": {
					"type": "boolean",
					"const": true
				},
				"five": {
					"type": "number",
					"const": 5
				},
				"nothing": {
					"type": "null"
				},
				"word": {
					"type": "string",
					"const": "word"
				},
				"maybe": {
					"type": "string",
					"const": "x"
				}
			},
			"required": [
				"yes",
				"five",
				"nothing",
				"word"
			],
			"additionalProperties": false
		},
		"Outer": {
			"type": "object",
			"properties": {
				"inner": {
					"type": "object",
					"properties": {
						"deep": {
							"anyOf": [
								{
									"type": "object",
									"properties": {
										"x": {
											"type": "integer",
											"minimum": -9007199254740991,
											"maximum": 9007199254740991
										}
									},
									"required": [
										"x"
									],
									"additionalProperties": false
								},
								{
									"type": "null"
								}
							]
						}
					},
					"required": [
						"deep"
					],
					"additionalProperties": false
				},
				"list": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"color": {
								"$ref": "#/$defs/Color"
							},
							"names": {
								"$ref": "#/$defs/Names"
							}
						},
						"required": [
							"color",
							"names"
						],
						"additionalProperties": false
					}
				},
				"type": {
					"type": "string",
					"enum": [
						"struct",
						"enum"
					]
				}
			},
			"required": [
				"inner",
				"list",
				"type"
			],
			"additionalProperties": false
		},
		"Event": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"type": {
							"type": "string",
							"const": "text"
						},
						"text": {
							"type": "string"
						}
					},
					"required": [
						"type",
						"text"
					],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"type": {
							"type": "string",
							"const": "tool-call"
						},
						"id": {
							"type": "string"
						},
						"input": {}
					},
					"required": [
						"type",
						"id",
						"input"
					],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"type": {
							"type": "string",
							"const": "tree"
						},
						"tree": {
							"$ref": "#/$defs/Tree"
						}
					},
					"required": [
						"type",
						"tree"
					],
					"additionalProperties": false
				}
			],
			"x-tag": "type"
		},
		"Legacy": {
			"type": "object",
			"properties": {
				"id": {
					"type": "string"
				},
				"tags": {
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			},
			"required": [
				"id",
				"tags"
			],
			"additionalProperties": false,
			"x-hooks": [
				{
					"kind": "preprocess",
					"name": "renameLegacy"
				}
			]
		},
		"Span": {
			"type": "object",
			"properties": {
				"from": {
					"type": "integer",
					"minimum": -9007199254740991,
					"maximum": 9007199254740991
				},
				"to": {
					"type": "integer",
					"minimum": -9007199254740991,
					"maximum": 9007199254740991
				}
			},
			"required": [
				"from",
				"to"
			],
			"additionalProperties": false,
			"x-hooks": [
				{
					"kind": "refine",
					"name": "ordered"
				}
			]
		},
		"Holder": {
			"type": "object",
			"properties": {
				"legacy": {
					"$ref": "#/$defs/Legacy"
				},
				"span": {
					"anyOf": [
						{
							"$ref": "#/$defs/Span"
						},
						{
							"type": "null"
						}
					]
				},
				"label": {
					"type": "string",
					"minLength": 1,
					"x-hooks": [
						{
							"kind": "preprocess",
							"name": "trimmed"
						}
					]
				},
				"spans": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/Span"
					}
				}
			},
			"required": [
				"legacy",
				"span",
				"label",
				"spans"
			],
			"additionalProperties": false
		},
		"Pair": {
			"type": "array",
			"prefixItems": [
				{
					"$ref": "#/$defs/Name"
				},
				{
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				}
			],
			"items": false,
			"minItems": 2,
			"maxItems": 2
		},
		"Code": {
			"type": "string",
			"maxLength": 8,
			"x-hooks": [
				{
					"kind": "match",
					"source": "^[a-z]+-\\d+$",
					"flags": "i",
					"message": "A code reads like abc-123."
				}
			]
		},
		"Even": {
			"type": "integer",
			"minimum": -9007199254740991,
			"maximum": 9007199254740991,
			"x-hooks": [
				{
					"kind": "refine",
					"name": "even",
					"message": "An even number."
				},
				{
					"kind": "refine",
					"name": "small"
				}
			]
		},
		"Tupled": {
			"type": "object",
			"properties": {
				"pair": {
					"$ref": "#/$defs/Pair"
				},
				"single": {
					"type": "array",
					"prefixItems": [
						{
							"type": "object",
							"properties": {
								"x": {
									"type": "number"
								}
							},
							"required": [
								"x"
							],
							"additionalProperties": false
						}
					],
					"items": false,
					"minItems": 1,
					"maxItems": 1
				},
				"nested": {
					"type": "array",
					"items": {
						"type": "array",
						"prefixItems": [
							{
								"type": "boolean"
							},
							{
								"anyOf": [
									{
										"type": "array",
										"prefixItems": [
											{
												"type": "string"
											},
											{
												"$ref": "#/$defs/Leaf"
											}
										],
										"items": false,
										"minItems": 2,
										"maxItems": 2
									},
									{
										"type": "null"
									}
								]
							}
						],
						"items": false,
						"minItems": 2,
						"maxItems": 2
					}
				},
				"code": {
					"$ref": "#/$defs/Code"
				},
				"word": {
					"type": "string",
					"x-hooks": [
						{
							"kind": "match",
							"source": "^\\S+$",
							"flags": ""
						}
					]
				},
				"even": {
					"$ref": "#/$defs/Even"
				},
				"range": {
					"type": "array",
					"prefixItems": [
						{
							"type": "integer",
							"minimum": -9007199254740991,
							"maximum": 9007199254740991
						},
						{
							"type": "integer",
							"minimum": -9007199254740991,
							"maximum": 9007199254740991
						}
					],
					"items": false,
					"minItems": 2,
					"maxItems": 2,
					"x-hooks": [
						{
							"kind": "refine",
							"name": "ascending",
							"message": "A range ascends."
						}
					]
				}
			},
			"required": [
				"pair",
				"single",
				"nested",
				"code",
				"word",
				"even",
				"range"
			],
			"additionalProperties": false
		},
		"Choice": {
			"anyOf": [
				{
					"type": "object",
					"properties": {
						"name": {
							"$ref": "#/$defs/Name"
						},
						"more": {
							"type": "array",
							"items": {
								"type": "integer",
								"minimum": 0,
								"maximum": 9007199254740991
							}
						}
					},
					"required": [
						"name",
						"more"
					],
					"additionalProperties": false
				},
				{
					"type": "integer",
					"minimum": -9007199254740991,
					"maximum": 9007199254740991,
					"x-hooks": [
						{
							"kind": "refine",
							"name": "even",
							"message": "An even number."
						}
					]
				},
				{
					"type": "string",
					"const": "off"
				}
			]
		},
		"Wrapped": {
			"type": "object",
			"properties": {
				"choice": {
					"$ref": "#/$defs/Choice"
				},
				"list": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/Choice"
					}
				},
				"event": {
					"$ref": "#/$defs/Event"
				}
			},
			"required": [
				"choice",
				"list",
				"event"
			],
			"additionalProperties": false
		},
		"NotFive": {
			"anyOf": [
				{
					"type": "integer",
					"minimum": -9007199254740991,
					"maximum": 9007199254740991
				},
				{
					"type": "string"
				}
			],
			"x-hooks": [
				{
					"kind": "refine",
					"name": "notFive",
					"message": "Not five."
				}
			]
		}
	}
}
