{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "lifecycle.input.json",
	"x-contract-version": "0.1.0",
	"$defs": {
		"TraceEntry": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "skip"
						},
						"cause": {
							"type": "string",
							"enum": [
								"passed",
								"deferred",
								"fellThrough"
							]
						},
						"entry": {
							"type": "string"
						},
						"label": {
							"type": "string"
						},
						"reason": {
							"$ref": "provider.input.json#/$defs/SkipReason"
						}
					},
					"required": [
						"kind",
						"cause",
						"entry",
						"label",
						"reason"
					]
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "held"
						},
						"entry": {
							"type": "string"
						},
						"waiting": {
							"$ref": "health.input.json#/$defs/GateWaiting"
						}
					},
					"required": [
						"kind",
						"entry",
						"waiting"
					]
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "released"
						},
						"entry": {
							"type": "string"
						}
					},
					"required": [
						"kind",
						"entry"
					]
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "admitted"
						},
						"entry": {
							"type": "string"
						},
						"admission": {
							"$ref": "health.input.json#/$defs/Admission"
						}
					},
					"required": [
						"kind",
						"entry",
						"admission"
					]
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "kept"
						},
						"entry": {
							"type": "string"
						},
						"model": {
							"type": "string"
						}
					},
					"required": [
						"kind",
						"entry",
						"model"
					]
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "attempt"
						},
						"entry": {
							"type": "string"
						},
						"model": {
							"type": "string"
						},
						"attempt": {
							"type": "integer",
							"minimum": 1,
							"maximum": 9007199254740991
						},
						"live": {
							"type": "boolean"
						},
						"again": {
							"type": "boolean"
						}
					},
					"required": [
						"kind",
						"entry",
						"model",
						"attempt",
						"live",
						"again"
					]
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "metered"
						},
						"call": {
							"$ref": "usage.input.json#/$defs/MeteredCall"
						}
					},
					"required": [
						"kind",
						"call"
					]
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "billing"
						},
						"entry": {
							"type": "string"
						},
						"reply": {
							"type": "string",
							"enum": [
								"ok",
								"failed"
							]
						},
						"usage": {
							"$ref": "step.input.json#/$defs/NormalizedUsage"
						}
					},
					"required": [
						"kind",
						"entry",
						"reply"
					]
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "failure"
						},
						"entry": {
							"type": "string"
						},
						"model": {
							"type": "string"
						},
						"failure": {
							"$ref": "step.input.json#/$defs/Failure"
						},
						"disposition": {
							"$ref": "provider.input.json#/$defs/Disposition"
						},
						"fresh": {
							"type": "boolean"
						},
						"onward": {
							"type": "boolean"
						}
					},
					"required": [
						"kind",
						"entry",
						"model",
						"failure",
						"fresh",
						"onward"
					]
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "settled"
						},
						"entry": {
							"type": "string"
						},
						"outcome": {
							"$ref": "health.input.json#/$defs/GateOutcome"
						},
						"retryAfterMs": {
							"type": "integer",
							"minimum": -9007199254740991,
							"maximum": 9007199254740991
						},
						"answer": {
							"$ref": "health.input.json#/$defs/GateSettled"
						}
					},
					"required": [
						"kind",
						"entry",
						"outcome",
						"answer"
					]
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "gateFailed"
						},
						"entry": {
							"type": "string"
						},
						"failure": {
							"$ref": "step.input.json#/$defs/Failure"
						},
						"onward": {
							"type": "boolean"
						}
					},
					"required": [
						"kind",
						"entry",
						"failure",
						"onward"
					]
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "retry"
						},
						"entry": {
							"type": "string"
						},
						"attempt": {
							"type": "integer",
							"minimum": 1,
							"maximum": 9007199254740991
						},
						"waitMs": {
							"type": "integer",
							"minimum": 0,
							"maximum": 9007199254740991
						},
						"why": {
							"type": "string",
							"enum": [
								"backoff",
								"retryAfter"
							]
						},
						"status": {
							"$ref": "health.input.json#/$defs/ErrorStatus"
						}
					},
					"required": [
						"kind",
						"entry",
						"attempt",
						"waitMs",
						"why",
						"status"
					]
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "limits"
						},
						"entry": {
							"type": "string"
						},
						"read": {
							"type": "boolean"
						},
						"limit": {
							"type": "number"
						},
						"reset": {
							"type": "string"
						}
					},
					"required": [
						"kind",
						"entry",
						"read"
					]
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "threw"
						},
						"entry": {
							"type": "string"
						},
						"message": {
							"type": "string"
						}
					},
					"required": [
						"kind",
						"entry",
						"message"
					]
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "served"
						},
						"entry": {
							"type": "string"
						},
						"label": {
							"type": "string"
						},
						"model": {
							"type": "string"
						}
					},
					"required": [
						"kind",
						"entry",
						"label",
						"model"
					]
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "stopped"
						}
					},
					"required": [
						"kind"
					]
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "notice"
						},
						"notice": {
							"$ref": "health.input.json#/$defs/Notice"
						}
					},
					"required": [
						"kind",
						"notice"
					]
				}
			],
			"x-tag": "kind"
		}
	}
}
