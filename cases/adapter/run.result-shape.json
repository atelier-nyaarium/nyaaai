		"connection": [
			{
				"type": "welcome",
				"version": "0.1.0"
			}
		],
		"runs": {
			"fits": [
				{
					"type": "done",
					"run": "fits",
					"seq": 1,
					"result": {
						"text": "fits"
					}
				}
			],
			"misfit": [
				{
					"type": "failed",
					"run": "misfit",
					"seq": 1,
					"code": "error",
					"message": "the result does not fit the command"
				}
			]
		},
		"files": {}
