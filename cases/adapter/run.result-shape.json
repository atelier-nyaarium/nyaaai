{
	"format": 2,
	"type": "run",
	"kind": "adapter.run",
	"name": "result-shape",
	"script": [
		{
			"send": {
				"type": "hello",
				"version": "0.1.0"
			}
		},
		{
			"await": {
				"type": "welcome"
			}
		},
		{
			"send": {
				"type": "start",
				"run": "misfit",
				"command": "testkit.misfit",
				"input": {
					"fits": false
				}
			}
		},
		{
			"await": {
				"type": "failed",
				"run": "misfit",
