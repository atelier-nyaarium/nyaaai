			}
		},
		{
			"send": {
				"type": "start",
				"run": "fits",
				"command": "testkit.misfit",
				"input": {
					"fits": true
				}
			}
		},
		{
			"await": {
				"type": "done",
				"run": "fits",
				"result": {
					"text": "fits"
