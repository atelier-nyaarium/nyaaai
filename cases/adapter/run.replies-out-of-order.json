		},
		{
			"await": {
				"type": "request",
				"run": "cut",
				"id": "q2"
			}
		},
		{
			"send": {
				"type": "reply",
				"run": "cut",
				"id": "q2",
				"value": "kept"
			}
		},
		{
			"send": {
				"type": "interrupt",
				"run": "cut"
			}
		},
		{
			"await": [
				{
					"type": "done",
					"run": "cut"
				},
				{
					"type": "failed",
					"run": "cut"
				}
			]
		},
		{
			"send": {
				"type": "reply",
				"run": "cut",
				"id": "q1",
				"value": "too late"
			}
		},
		{
			"await": {
				"type": "fault",
				"code": "unknown_run"
			}
		}
	],
	"expected": {
		"exit": 0,
		"connection": [
			{
				"type": "welcome",
				"version": "0.1.0"
			},
			{
				"type": "fault",
				"code": "unknown_reply",
				"run": "many",
