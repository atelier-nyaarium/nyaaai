{
	"format": 2,
	"type": "run",
	"kind": "adapter.run",
	"name": "replies-out-of-order",
	"script": [
		{
			"send": {
				"type": "hello",
				"version": "0.1.0"
			}
		},
		{
			"await": {
				"type": "welcome"
			}
		},
		{
			"send": {
				"type": "start",
				"run": "many",
				"command": "testkit.converse",
				"input": {
					"requests": 3,
					"together": true
				},
				"fixed": {
					"nowMs": 1794535200000,
					"stepMs": 1000,
					"idPrefix": "many-"
				}
			}
		},
		{
			"await": {
				"type": "request",
				"run": "many",
				"id": "q1"
			}
		},
		{
			"await": {
				"type": "request",
				"run": "many",
				"id": "q2"
