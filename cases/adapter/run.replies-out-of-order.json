			],
			"many": [
				{
					"type": "request",
					"run": "many",
					"id": "q1",
					"kind": "echo",
					"input": {
						"count": 1
					}
				},
				{
					"type": "request",
					"run": "many",
					"id": "q2",
					"kind": "echo",
					"input": {
						"count": 2
					}
				},
				{
					"type": "request",
					"run": "many",
					"id": "q3",
					"kind": "echo",
					"input": {
						"count": 3
