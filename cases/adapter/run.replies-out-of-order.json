		{
			"send": {
				"type": "reply",
				"run": "many",
				"id": "q3",
				"value": "twice"
			}
		},
		{
			"await": {
				"type": "fault",
				"code": "unknown_reply"
			}
		},
		{
			"send": {
				"type": "reply",
				"run": "many",
				"id": "q1",
				"value": {
					"first": [
						1
					]
				}
			}
		},
		{
			"await": [
				{
					"type": "done",
					"run": "many"
				},
				{
					"type": "failed",
					"run": "many"
				}
			]
		},
		{
			"send": {
				"type": "start",
				"run": "cut",
				"command": "testkit.converse",
				"input": {
					"requests": 2,
