				"type": "interrupt",
				"run": "talk"
			}
		},
		{
			"await": [
				{
					"type": "done",
					"run": "talk"
				},
				{
					"type": "failed",
					"run": "talk"
				}
			]
		}
	],
	"expected": {
		"exit": 0,
		"connection": [
			{
				"type": "welcome",
				"version": "0.1.0"
			},
			{
				"type": "fault",
				"code": "unknown_reply",
				"run": "talk",
				"message": "no such request"
			},
			{
				"type": "fault",
				"code": "unknown_reply",
				"run": "talk",
				"message": "no such request"
			}
		],
		"runs": {
