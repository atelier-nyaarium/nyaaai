				"value": 0
			}
		},
		{
			"await": {
				"type": "fault",
				"code": "unknown_reply"
			}
		},
		{
			"send": {
				"type": "reply",
				"run": "talk",
				"id": "q1",
				"value": {
					"answered": [
						1,
						null
					]
				}
			}
		},
		{
			"await": {
				"type": "request",
				"run": "talk",
				"id": "q2"
			}
		},
		{
			"send": {
				"type": "reply",
				"run": "talk",
				"id": "q1",
				"value": "twice"
			}
		},
		{
			"await": {
				"type": "fault",
				"code": "unknown_reply"
			}
		},
		{
			"send": {
				"type": "steer",
				"run": "talk",
				"text": "second"
			}
		},
		{
			"await": {
