{
	"format": 2,
	"type": "function",
	"kind": "schemaProjection.project",
	"name": "strict-refuses-optional-field",
	"input": {
		"projection": "strict",
		"schema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"note": {
					"type": "string"
				}
			},
			"additionalProperties": false
		},
		"value": null
	},
	"expected": {
		"output": null,
		"refusal": "A strict json_schema cannot carry an optional field `note`; make it `.nullable()`, which is what strict mode sends."
	}
}
