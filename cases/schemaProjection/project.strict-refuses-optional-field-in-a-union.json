{
	"format": 2,
	"type": "function",
	"kind": "schemaProjection.project",
	"name": "strict-refuses-optional-field-in-a-union",
	"input": {
		"projection": "strict",
		"schema": {
			"$schema": "https://json-schema.org/draft/2020-12/schema",
			"type": "object",
			"properties": {
				"at": {
					"anyOf": [
						{
							"type": "object",
							"properties": {
								"a": {
									"type": "string"
								}
							},
							"required": [
								"a"
							],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"b": {
									"type": "string"
								}
							},
							"additionalProperties": false
						}
					]
				}
			},
			"required": [
				"at"
			],
			"additionalProperties": false
		},
		"value": null
	},
	"expected": {
		"output": null,
		"refusal": "A strict json_schema cannot carry an optional field `b`; make it `.nullable()`, which is what strict mode sends."
	}
}
