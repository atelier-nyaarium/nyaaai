{
	"format": 2,
	"type": "function",
	"kind": "schemaProjection.project",
	"name": "strict-refuses-in-a-branch",
	"input": {
		"projection": "strict",
		"schema": {
			"type": "object",
			"properties": {
				"a": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "object",
							"properties": {
								"b": {
									"type": "string"
								}
							}
						}
					]
				}
			},
			"required": [
				"a"
			]
		},
		"value": null
	},
	"expected": {
		"output": null,
		"refusal": "A strict json_schema cannot carry an optional field `b`; make it `.nullable()`, which is what strict mode sends."
	}
}
