{
	"format": 2,
	"type": "function",
	"kind": "transport.exchange",
	"name": "caller-abort-just-as-a-chunk-arrives",
	"input": {
		"codec": {
			"family": "chat-completions",
			"dialect": "openrouter"
		},
		"baseUrl": "https://openrouter.ai/api/v1",
		"label": "OpenRouter",
		"userAgent": "lab-app/1.0",
		"keys": [
			"fake-key-one"
		],
		"startMs": 1800000000000,
		"script": {
			"kind": "inline",
			"exchanges": [
				{
					"status": 200,
					"headers": [
						[
							"content-type",
							"text/event-stream"
						]
					],
					"chunks": [
						{
							"kind": "text",
							"text": "data: {\"id\":\"gen-1\",\"provider\":\"Azure\",\"choices\":[{\"index\":0,\"delta\":{\"role\":\"assistant\",\"content\":\"Hi\"}}]}\n\n",
							"delayMs": 10
						},
						{
							"kind": "text",
							"text": "data: {\"id\":\"gen-1\",\"provider\":\"Azure\",\"choices\":[{\"index\":0,\"delta\":{\"role\":\"assistant\",\"content\":\" there\"}}]}\n\n",
							"delayMs": 10
						},
						{
							"kind": "text",
							"text": "data: [DONE]\n\n"
						}
					]
				}
			]
		},
		"calls": [
			{
				"kind": "stream",
				"request": {
					"model": "openai/gpt-6-luna",
					"system": [],
					"history": [
						{
							"role": "user",
							"text": "Hi"
						}
					],
					"cache": {
						"kind": "none"
					},
					"session": "root-1",
					"zdrOnly": true
				},
				"abortAfterMs": 10
			}
		]
	},
	"expected": {
		"calls": [
			{
				"events": [],
				"result": null,
				"answer": null,
				"failure": null,
				"thrown": "caller aborted",
				"aborted": true,
				"nowMs": 1800000000010
			}
		],
		"requests": [
			{
				"method": "POST",
				"url": "https://openrouter.ai/api/v1/chat/completions",
				"headers": [
					[
						"Content-Type",
						"application/json"
					],
					[
						"Accept",
						"text/event-stream"
					],
					[
						"Authorization",
						"Bearer fake-key-one"
					],
					[
						"User-Agent",
						"lab-app/1.0"
					]
				],
				"body": "{\"model\":\"openai/gpt-6-luna\",\"messages\":[{\"role\":\"user\",\"content\":\"Hi\"}],\"stream\":true,\"session_id\":\"root-1\",\"provider\":{\"zdr\":true,\"data_collection\":\"deny\",\"require_parameters\":true}}"
			}
		],
		"log": [
			"OpenRouter 200 - -"
		],
		"settled": [],
		"keyReads": 1,
		"read": [
			0
		],
		"waiting": []
	}
}
