{
	"format": 2,
	"type": "function",
	"kind": "codec.encode",
	"name": "opencode-schema-in-prompt",
	"input": {
		"codec": {
			"family": "chat-completions",
			"dialect": "opencode",
			"facts": {
				"api": {
					"family": "chat-completions",
					"structured": false,
					"choice": [
						"auto"
					],
					"strict": false,
					"reasoning": "reasoning_content"
				},
				"efforts": [
					"high"
				]
			}
		},
		"request": {
			"model": "openai/gpt-6-luna",
			"system": [
				"Rules."
			],
			"history": [
				{
					"role": "user",
					"text": "Hi"
				}
			],
			"cache": {
				"kind": "implicit"
			},
			"session": "root-1",
			"zdrOnly": true,
			"tools": [
				{
					"name": "finish",
					"description": "Finish.",
					"parameters": {
						"type": "object"
					}
				}
			],
			"toolChoice": {
				"name": "finish"
			},
			"schema": {
				"name": "title",
				"json": {
					"type": "object",
					"properties": {
						"title": {
							"type": "string"
						}
					},
					"required": [
						"title"
					]
				}
			}
		},
		"mode": "complete"
	},
	"expected": {
		"encoded": {
			"path": "/openai/v1/chat/completions",
			"body": {
				"model": "openai/gpt-6-luna",
				"messages": [
					{
						"role": "system",
						"content": "Rules."
					},
					{
						"role": "system",
						"content": "Answer with one JSON object matching this JSON Schema, and nothing else:\n{\"type\":\"object\",\"properties\":{\"title\":{\"type\":\"string\"}},\"required\":[\"title\"]}"
					},
					{
						"role": "user",
						"content": "Hi"
					}
				],
				"stream": false,
				"tools": [
					{
						"type": "function",
						"function": {
							"name": "finish",
							"description": "Finish.",
							"parameters": {
								"type": "object"
							}
						}
					}
				]
			},
			"headers": {
				"x-opencode-session": "root-1"
			}
		},
		"refusal": null
	}
}
