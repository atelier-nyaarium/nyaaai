{
	"format": 2,
	"type": "function",
	"kind": "codec.encode",
	"name": "openrouter-schema-refused-optional-field",
	"input": {
		"codec": {
			"family": "chat-completions",
			"dialect": "openrouter"
		},
		"request": {
			"model": "openai/gpt-6-luna",
			"system": [
				"Rules."
			],
			"history": [
				{
					"role": "user",
					"text": "Hi"
				}
			],
			"cache": {
				"kind": "implicit"
			},
			"session": "root-1",
			"zdrOnly": true,
			"schema": {
				"name": "pick",
				"json": {
					"type": "object",
					"properties": {
						"a": {
							"type": "string"
						}
					}
				}
			}
		},
		"mode": "stream"
	},
	"expected": {
		"encoded": null,
		"refusal": "A strict json_schema cannot carry an optional field `a`; make it `.nullable()`, which is what strict mode sends."
	}
}
