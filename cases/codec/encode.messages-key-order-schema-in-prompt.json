{
	"format": 2,
	"type": "function",
	"kind": "codec.encode",
	"name": "messages-key-order-schema-in-prompt",
	"input": {
		"codec": {
			"family": "messages",
			"dialect": "opencode",
			"prefix": "/anthropic/v1",
			"facts": {
				"api": {
					"family": "messages",
					"structured": false,
					"choice": [
						"auto",
						"none",
						"required",
						"tool"
					],
					"strict": true,
					"toggle": true
				},
				"efforts": [
					"low",
					"high"
				],
				"outputLimit": 128000
			}
		},
		"request": {
			"model": "claude-haiku-5-5",
			"system": [
				"Rules."
			],
			"history": [
				{
					"role": "user",
					"text": "Hi"
				}
			],
			"cache": {
				"kind": "implicit"
			},
			"session": "root-1",
			"zdrOnly": true,
			"schema": {
				"name": "scrambled",
				"json": {
					"type": "object",
					"required": [
						"zeta",
						"alpha",
						"10",
						"2"
					],
					"properties": {
						"2": {
							"type": "number"
						},
						"10": {
							"type": "boolean"
						},
						"zeta": {
							"type": "string",
							"description": "Last letter."
						},
						"alpha": {
							"type": "integer"
						}
					},
					"additionalProperties": false
				}
			}
		},
		"mode": "complete"
	},
	"expected": {
		"encoded": {
			"path": "/anthropic/v1/messages",
			"body": {
				"model": "claude-haiku-5-5",
				"max_tokens": 128000,
				"system": [
					{
						"type": "text",
						"text": "Rules."
					},
					{
						"type": "text",
						"text": "Answer with one JSON object matching this JSON Schema, and nothing else:\n{\"type\":\"object\",\"required\":[\"zeta\",\"alpha\",\"10\",\"2\"],\"properties\":{\"2\":{\"type\":\"number\"},\"10\":{\"type\":\"boolean\"},\"zeta\":{\"type\":\"string\",\"description\":\"Last letter.\"},\"alpha\":{\"type\":\"integer\"}},\"additionalProperties\":false}"
					}
				],
				"messages": [
					{
						"role": "user",
						"content": [
							{
								"type": "text",
								"text": "Hi"
							}
						]
					}
				],
				"thinking": {
					"type": "adaptive",
					"display": "summarized"
				},
				"stream": false
			},
			"headers": {
				"x-opencode-session": "root-1"
			}
		},
		"refusal": null
	}
}
