{
	"format": 2,
	"type": "function",
	"kind": "codec.encode",
	"name": "openrouter-schema-refused-by-ref",
	"input": {
		"codec": {
			"family": "chat-completions",
			"dialect": "openrouter"
		},
		"request": {
			"model": "openai/gpt-6-luna",
			"system": [
				"Rules."
			],
			"history": [
				{
					"role": "user",
					"text": "Hi"
				}
			],
			"cache": {
				"kind": "implicit"
			},
			"session": "root-1",
			"zdrOnly": true,
			"schema": {
				"name": "tree",
				"json": {
					"$ref": "#/$defs/node",
					"$defs": {
						"node": {
							"type": "object"
						}
					}
				}
			}
		},
		"mode": "stream"
	},
	"expected": {
		"encoded": null,
		"refusal": "A strict json_schema cannot carry `$ref`; reshape the answer without it."
	}
}
