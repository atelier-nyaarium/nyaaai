{
	"format": 2,
	"type": "function",
	"kind": "codec.encode",
	"name": "messages-replay-summary-segments-go-out-as-thinking",
	"input": {
		"codec": {
			"family": "messages",
			"dialect": "opencode",
			"prefix": "/anthropic/v1",
			"facts": {
				"api": {
					"family": "messages",
					"structured": true,
					"choice": [
						"auto",
						"none",
						"required",
						"tool"
					],
					"strict": true,
					"toggle": true
				},
				"efforts": [
					"low",
					"high"
				],
				"outputLimit": 128000
			}
		},
		"request": {
			"model": "claude-haiku-5-5",
			"system": [
				"Rules."
			],
			"history": [
				{
					"role": "step",
					"producer": {
						"model": "claude-haiku-5-5"
					},
					"parts": [
						{
							"kind": "thought",
							"type": "thinking",
							"opaque": "sig",
							"segments": [
								{
									"kind": "summary",
									"text": "sum"
								}
							]
						},
						{
							"kind": "text",
							"text": "Hi"
						}
					]
				}
			],
			"cache": {
				"kind": "implicit"
			},
			"session": "root-1",
			"zdrOnly": true
		},
		"mode": "stream"
	},
	"expected": {
		"encoded": {
			"path": "/anthropic/v1/messages",
			"body": {
				"model": "claude-haiku-5-5",
				"max_tokens": 128000,
				"system": [
					{
						"type": "text",
						"text": "Rules."
					}
				],
				"messages": [
					{
						"role": "assistant",
						"content": [
							{
								"type": "thinking",
								"thinking": "sum",
								"signature": "sig"
							},
							{
								"type": "text",
								"text": "Hi"
							}
						]
					}
				],
				"thinking": {
					"type": "adaptive",
					"display": "summarized"
				},
				"stream": true
			},
			"headers": {
				"x-opencode-session": "root-1"
			}
		},
		"refusal": null
	}
}
