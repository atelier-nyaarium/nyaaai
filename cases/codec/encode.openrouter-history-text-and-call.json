{
	"format": 2,
	"type": "function",
	"kind": "codec.encode",
	"name": "openrouter-history-text-and-call",
	"input": {
		"codec": {
			"family": "chat-completions",
			"dialect": "openrouter"
		},
		"request": {
			"model": "openai/gpt-6-luna",
			"system": [
				"Rules."
			],
			"history": [
				{
					"role": "step",
					"parts": [
						{
							"kind": "text",
							"text": "Reading "
						},
						{
							"kind": "text",
							"text": "now.",
							"phase": "final"
						},
						{
							"kind": "call",
							"index": 0,
							"wireId": "call_a",
							"name": "read",
							"arguments": "{}"
						},
						{
							"kind": "result",
							"index": 0,
							"output": "x",
							"isError": false
						}
					]
				}
			],
			"cache": {
				"kind": "implicit"
			},
			"session": "root-1",
			"zdrOnly": true
		},
		"mode": "stream"
	},
	"expected": {
		"encoded": {
			"path": "/chat/completions",
			"body": {
				"model": "openai/gpt-6-luna",
				"messages": [
					{
						"role": "system",
						"content": "Rules."
					},
					{
						"role": "assistant",
						"content": "Reading now.",
						"tool_calls": [
							{
								"id": "call_a",
								"type": "function",
								"function": {
									"name": "read",
									"arguments": "{}"
								}
							}
						]
					},
					{
						"role": "tool",
						"tool_call_id": "call_a",
						"content": "x"
					}
				],
				"stream": true,
				"session_id": "root-1",
				"provider": {
					"zdr": true,
					"data_collection": "deny",
					"require_parameters": true
				}
			}
		},
		"refusal": null
	}
}
