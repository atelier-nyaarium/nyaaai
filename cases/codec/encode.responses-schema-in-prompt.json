{
	"format": 2,
	"type": "function",
	"kind": "codec.encode",
	"name": "responses-schema-in-prompt",
	"input": {
		"codec": {
			"family": "responses",
			"dialect": "opencode",
			"prefix": "/openai/v1",
			"facts": {
				"api": {
					"family": "responses",
					"structured": false,
					"choice": [
						"auto",
						"none",
						"required",
						"tool"
					],
					"strict": true
				},
				"efforts": [
					"none",
					"low",
					"high"
				]
			}
		},
		"request": {
			"model": "gpt-6-luna",
			"system": [
				"Rules."
			],
			"history": [
				{
					"role": "user",
					"text": "Hi"
				}
			],
			"cache": {
				"kind": "implicit"
			},
			"session": "root-1",
			"zdrOnly": true,
			"schema": {
				"name": "title",
				"json": {
					"type": "object",
					"properties": {
						"title": {
							"type": "string"
						}
					},
					"required": [
						"title"
					]
				}
			}
		},
		"mode": "complete"
	},
	"expected": {
		"encoded": {
			"path": "/openai/v1/responses",
			"body": {
				"model": "gpt-6-luna",
				"instructions": "Rules.\n\nAnswer with one JSON object matching this JSON Schema, and nothing else:\n{\"type\":\"object\",\"properties\":{\"title\":{\"type\":\"string\"}},\"required\":[\"title\"]}",
				"input": [
					{
						"type": "message",
						"role": "user",
						"content": "Hi"
					}
				],
				"store": false,
				"include": [
					"reasoning.encrypted_content"
				],
				"stream": false
			},
			"headers": {
				"x-opencode-session": "root-1"
			}
		},
		"refusal": null
	}
}
